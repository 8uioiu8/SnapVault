# =========================================================================== #
# SnapVault .gitignore
#
# 两条原则：
#   1. 只提交"源码 + 打包脚本 + 文档"，构建产物和运行产物一律不进仓库；
#   2. 含**本机画面或本机路径**的东西一律不进仓库 —— 这个项目会截图，
#      它的诊断目录里全是我自己屏幕上的东西。
# =========================================================================== #

# ---- Python -------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- PyInstaller 构建产物（115 MB + 18 MB，且可从源码重建）----------------- #
build/
dist/
*.manifest
# 注意：packaging/SnapVault.spec 是**源文件**，要提交，所以不能用 *.spec。
!packaging/*.spec

# ---- 运行期产物 ---------------------------------------------------------- #
# 心跳文件 / 图库索引 / 日志：都在用户机器上生成，跟仓库无关
.snapvault/
*.log
trial-report.html
_smoke_*.json

# ---- 诊断脚本与实拍截图：**默认不公开** ---------------------------------- #
# _probe/ 里的 PNG 是真实屏幕截图（聊天记录、浏览器标签、游戏界面…），
# 里面的 .py 也硬编码了作者本机的绝对路径。
# 想让别人看到这些验证脚本的话，先做两件事：
#   1. 把 sys.path.insert(0, r"<你的项目路径>") 换成
#      Path(__file__).resolve().parents[1] 这类可移植写法；
#   2. 把 _probe/*.png 与 _probe/icons/ 排除掉，再放开下面这行。
_probe/

# ---- 本机配置与密钥 ------------------------------------------------------ #
# 真实配置在 %APPDATA%\SnapVault\config.json（不在仓库里，这里只是防手滑复制）。
# 配置里有 **AI 接口的 API Key**，任何情况下都不要提交。
config.json
*.local.json
.env
.env.*
*.pem
*.key
